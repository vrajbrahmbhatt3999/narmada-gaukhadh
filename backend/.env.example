# Backend environment variables — DO NOT commit .env with real values
# Copy this file to .env and fill in the values

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/narmada_gaukhadh

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── URLs ─────────────────────────────────────────────────────────────────────
# Backend public URL (for PayU success/failure redirect targets)
BACKEND_BASE_URL=http://localhost:4000

# Frontend URL (where users are redirected after payment)
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ── PayU Payment Gateway ─────────────────────────────────────────────────────
# Set PAYU_ENV to 'production' only after full sandbox testing
PAYU_ENV=sandbox

# Obtain from PayU merchant dashboard — NEVER commit real values
PAYU_KEY=your_payu_key_here
PAYU_SALT=your_payu_salt_here
