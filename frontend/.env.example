# Frontend environment variables — DO NOT commit .env with real values
# Copy this file to .env.local and fill in values

# ── API ──────────────────────────────────────────────────────────────────────
# In dev: proxy is handled by Vite (see vite.config.ts)
# In production: set to your deployed backend URL
VITE_API_BASE_URL=

# ── Business config overrides (optional) ─────────────────────────────────────
# These are set in src/config/products.ts by default.
# Use env vars only if you need environment-specific overrides.
# VITE_WHATSAPP_NUMBER=919876543210
# VITE_SITE_URL=https://narmadagaukhadh.com
